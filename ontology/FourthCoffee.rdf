    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/GreenLot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>Data di acquisto del lotto: è la data rispetto a cui si verifica la Fourth Hand Standard.</rdfs:comment>
    <skos:altLabel>data di acquisto</skos:altLabel>
    <skos:altLabel>data acquisto</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/GreenLot_Processor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Processor</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/GreenLot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Il processor (seconda mano) che ha lavorato i chicchi.</rdfs:comment>
    <skos:altLabel>lavoratore</skos:altLabel>
    <skos:altLabel>beneficio</skos:altLabel>
    <skos:altLabel>processor</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/Store_StoreId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>StoreId</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/Store"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Codice univoco del negozio (es. S003).</rdfs:comment>
    <skos:altLabel>codice negozio</skos:altLabel>
  </rdf:Description>
