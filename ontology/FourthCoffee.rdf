    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>RoastProfile</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/RoastBatch"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Profilo di tostatura.</rdfs:comment>
    <skos:altLabel>profilo tostatura</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/PackagingRun_PackagingRunId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>PackagingRunId</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/PackagingRun"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Codice univoco del ciclo di confezionamento.</rdfs:comment>
    <skos:altLabel>codice confezionamento</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/Complaint_ComplaintId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>ComplaintId</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/Complaint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Codice univoco del reclamo.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/Shipment_deliveredTo_Store">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>deliveredTo</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/Shipment"/>
    <rdfs:range rdf:resource="https://fourthcoffee.example/ontology/Store"/>
    <rdfs:comment>La Shipment è stata consegnata a questo Store (destination_id = StoreId).</rdfs:comment>
    <skos:altLabel>consegnata a</skos:altLabel>
    <skos:altLabel>destinazione</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/GreenLot_CuppingScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
