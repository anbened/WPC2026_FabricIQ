    <skos:altLabel>punteggio cupping</skos:altLabel>
    <skos:altLabel>punteggio qualità</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/Certification_LastAuditOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>LastAuditOutcome</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/Certification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Esito dell'ultimo audit: Passed o Failed.</rdfs:comment>
    <skos:altLabel>esito audit</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://fourthcoffee.example/ontology/Complaint_ComplaintDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>ComplaintDate</rdfs:label>
    <rdfs:domain rdf:resource="https://fourthcoffee.example/ontology/Complaint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment>Data del reclamo.</rdfs:comment>
    <skos:altLabel>data reclamo</skos:altLabel>
  </rdf:Description>
</rdf:RDF>
